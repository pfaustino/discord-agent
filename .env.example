# Discord bot token — Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# Discord APPLICATION ID — Developer Portal > your app > General Information.
# Required: without it no slash command can be registered.
CLIENT_ID=

# Optional, for fast iteration: a test server's ID. Guild-scoped command
# registration appears instantly instead of waiting ~1hr for global.
DEV_GUILD_ID=

# Your Discord user ID — only this user can run server-management commands.
# (Discord: Settings > Advanced > Developer Mode, then right-click your profile > Copy User ID)
OWNER_ID=

# The repo Max lives in — gives him full GitHub visibility (branches,
# contributor PRs, diffs, commits, files at any ref), not just what's
# checked out locally. Defaults to this repo; only change if it moves.
GITHUB_REPO=seed0001/discord-agent

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default AI model (changeable per server in the dashboard)
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Model for background work — signal classification, memory upkeep,
# de-escalation assessments (~85% of call volume). "openrouter/free"
# cycles through OpenRouter's free-model pool at $0; junk replies from
# odd free models are discarded safely.
OPENROUTER_UTILITY_MODEL=openrouter/free

# Spend breaker: max background model calls per hour (0 = uncapped)
OPENROUTER_BG_HOURLY_CAP=240

# Image and video generation. These hit OpenRouter's /images and /videos
# endpoints and are billed per generation, not per token — a clip costs
# roughly ten times an image. Both are overridable per server in the
# dashboard, along with who's allowed to generate (owner-only by default)
# and an hourly ceiling on video.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_VIDEO_MODEL=google/veo-3.1

# Optional: GitHub token for repo analysis — raises the API rate limit from
# 60 to 5000 requests/hour. A fine-grained token with no extra permissions works.
GITHUB_TOKEN=

# Web search — Tavily (free tier at https://tavily.com). Without it,
# web_search reports itself unavailable rather than degrading silently.
TAVILY_API_KEY=

# The E2B repo sandbox was not carried over to the Node bot. E2B_API_KEY and
# GITHUB_WRITE_TOKEN are read by nothing and can be removed.

# Voice transcription (optional — enables voice-channel monitoring & wake words).
# Any OpenAI-compatible /audio/transcriptions endpoint works:
#   OpenAI:  TRANSCRIPTION_API_URL=https://api.openai.com/v1        TRANSCRIPTION_MODEL=whisper-1
#   Groq:    TRANSCRIPTION_API_URL=https://api.groq.com/openai/v1   TRANSCRIPTION_MODEL=whisper-large-v3
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# Fish Audio TTS for spoken voice replies (optional — falls back to edge-tts).
# Get a key at fish.audio. FISH_VOICE_ID is the voice model's reference id
# (pick a voice on fish.audio and copy the id from its page/URL).
# FISH_TTS_MODEL: "s2.1-pro-free" (default — free API tier, free-form
# [voice direction] tags), "s2.1-pro"/"s2-pro" (paid), or "s1" (fixed
# (emotion) tag vocabulary). The AI is prompted with the right tag style.
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
FISH_VOICE_ID=

# Free TTS fallback when FISH_API_KEY is unset (Microsoft Edge neural voice).
# Defaults to en-US-GuyNeural, the voice this has always used — set this to
# change how the bot sounds. Full list: speech.microsoft.com/portal/voicegallery
# EDGE_TTS_VOICE=en-US-JennyNeural

# Password to log in to the web dashboard
DASHBOARD_PASSWORD=

# Random secret for signing dashboard sessions (any long random string).
# Also authenticates the voice listener sidecar to the bot's internal API,
# so it's REQUIRED for voice monitoring to work.
SECRET_KEY=

# Voice runs in the bot's own process now — there is no sidecar, and
# SIDECAR_PORT is read by nothing.

# Voice noise filtering: utterances shorter than this many seconds, or quieter
# than this RMS loudness (0-32768), are dropped as background-noise blips
MIN_UTTERANCE_SEC=1.5
MIN_UTTERANCE_RMS=300

# SQLite path. On Railway, attach a volume and point this inside it, e.g.
# /data/nodebot.db. Do NOT point it at the Python bot's /data/bot.db: the two
# schemas store Discord IDs differently (TEXT here, INTEGER there). Use
# nodebot/src/migrate-settings.js to carry settings across instead.
DATABASE_PATH=data/nodebot.db

# Web port (Railway sets PORT automatically)
PORT=8000

# Which backends she offers when the current one gets rate limited, in
# preference order (comma-separated OpenRouter model ids). Set this and it
# replaces the automatic pick entirely.
#
# Leave it empty and she picks three from the live model catalog: one free,
# one cheap, one from a steady vendor. That spread is deliberate — three free
# models are three models that hit the same daily quota on the same day, which
# is the failure this is routing around.
OPENROUTER_FALLBACK_MODELS=

# Platform staff — comma-separated emails. Any account signed up with one of
# these can see the order queue and issue credits, whatever its stored flag
# says. This is the bootstrap: the first staff account cannot be promoted by
# an existing one, because there isn't one. It is also the way back in if the
# database is what you cannot reach.
#
# Leave empty on a self-hosted install. With no staff and no registered
# servers, the credit system is inert — nothing is metered and nothing is
# gated.
PLATFORM_STAFF_EMAILS=
